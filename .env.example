# Copy to .env and fill in values before running `docker compose up`.

# --- MySQL (runs as a container managed by docker compose) ---
DB_NAME=sbs_dev
DB_USER=sbs
DB_PASS=changeme
DB_ROOT_PASS=changemeroot

# --- Backend ---
# Required. Must be at least 16 characters.
JWT_SECRET=replace-with-a-long-random-string
JWT_TTL=12h
BCRYPT_ROUNDS=12

# CORS origin the backend will accept.
# - Local Vite dev server:      http://localhost:5173
# - Dockerized nginx frontend:  http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000
